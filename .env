# Configuration de EE Salon
# Lue au démarrage de l'application.
# Identité du salon, TVA, devise et utilisateur par défaut :
# appliqués uniquement à la création de la base (premier lancement).
# Ensuite, l'écran Réglages modifie la base locale.
# Horaires d'agenda, locale, fichier SQLite et seuil de stock par défaut :
# relus à chaque démarrage.

# --- Identité du salon ---
SALON_NAME="Mon Salon de Beauté"
SALON_ADDRESS="12 rue des Fleurs, 75011 Paris"
SALON_PHONE="01 23 45 67 89"
SALON_EMAIL="contact@monsalon.fr"
SALON_SIRET=""

# --- Facturation ---
# Code ISO 4217
CURRENCY=EUR
# Taux de TVA en points de base : 2000 = 20,00 %
VAT_RATE_BPS=2000
# Préfixe des numéros : FAC-2026-0001
INVOICE_PREFIX=FAC

# --- Utilisateur par défaut (créé s'il n'y a encore aucun employé) ---
# Rôle : admin | manager | receptionist | stylist
DEFAULT_USER_FIRST_NAME=Admin
DEFAULT_USER_LAST_NAME=Salon
DEFAULT_USER_EMAIL=admin@salon.local
DEFAULT_USER_PHONE=""
DEFAULT_USER_ROLE=admin
DEFAULT_USER_COLOR="#2F5F8A"

# --- Base de données ---
# Nom du fichier SQLite, dans le dossier de données de l'application
DATABASE_FILENAME=salon.db

# --- Agenda (relu à chaque lancement) ---
AGENDA_OPEN_HOUR=8
AGENDA_CLOSE_HOUR=20
# Durée d'un créneau, en minutes : 5, 10, 15, 20, 30 ou 60
AGENDA_SLOT_MINUTES=15

# --- Affichage ---
LOCALE=fr-FR
# Seuil proposé à la création d'un produit
LOW_STOCK_DEFAULT=3
