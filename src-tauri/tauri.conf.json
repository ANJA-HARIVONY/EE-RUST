{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EE Salon",
  "version": "0.1.0",
  "identifier": "com.eesalon.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EE Salon",
        "width": 1360,
        "height": 860,
        "minWidth": 1100,
        "minHeight": 700,
        "backgroundColor": "#e7eef5"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
